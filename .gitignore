# demo recordings and thumbnail sources, far too large for the repo
/Presentation/

# generated deck, kept out of a public repo
/EnoughAboutTheWeather.pdf

# working copy of the sample deck; the published one is public/enough-about-the-weather-sample.csv
/EnoughAboutTheWeatherSampleQuestions.csv
